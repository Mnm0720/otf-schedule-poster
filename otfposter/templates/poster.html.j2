<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>OTF {{ title_month }} Schedule</title>
<style>
{{ font_css }}
:root{--orange:#F4511E;--accent:#9C300F;--orange-lt:#FFF1EB;--ink:#20242B;--muted:#505B67;--line:#DCE1E6}
*{box-sizing:border-box;margin:0;padding:0}
body{width:1200px;background:#fff;font-family:'Barlow',system-ui,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased}
.poster{width:1200px;padding:26px 30px;background:#fff}
.frame{border-top:7px solid var(--orange);padding-top:22px}
header{margin-bottom:22px}
h1{font-family:'Barlow Condensed','Barlow',sans-serif;font-size:58px;line-height:1.02;font-weight:700;letter-spacing:.3px}
h1 .otf{color:var(--accent)}
.sub{font-size:21px;color:var(--muted);margin-top:8px;font-weight:500}
.theme{display:inline-block;margin-top:14px;padding:7px 12px;border-radius:6px;background:var(--orange-lt);color:var(--accent);font-size:20px;font-weight:700;line-height:1.25;overflow-wrap:anywhere}
.tagline{font-size:18px;color:var(--muted);line-height:1.4;margin-top:9px}
.tagline b,.tagline strong{color:var(--accent)}
.ribbon{margin:0 0 14px;padding:10px 13px;border:1px solid var(--line);border-radius:8px;display:flex;align-items:baseline;gap:14px}
.ribbon .tag{font-size:15px;font-weight:700;white-space:nowrap;color:var(--accent)}
.ribbon .txt{font-size:17px;line-height:1.4;color:var(--ink)}
.ribbon.event{background:var(--orange-lt);border-color:#F6CFBE}
.cal{border:1.5px solid #AAB2BC;border-radius:9px;overflow:hidden}
.cal table{width:100%;border-collapse:collapse;table-layout:fixed}
.cal th{background:var(--ink);color:#fff;font-family:'Barlow Condensed','Barlow',sans-serif;font-size:19px;font-weight:700;letter-spacing:1.2px;padding:10px 0;text-transform:uppercase}
.cal td{border:1px solid var(--line);vertical-align:top;height:128px;padding:9px 8px 10px;background:#fff}
.cal td.blank{background:#F1F3F6}.cal td.weekend{background:#F8F9FB}
.dnum{display:flex;justify-content:space-between;align-items:center;font-size:29px;line-height:1.1;font-weight:700;color:var(--ink)}
.pills{margin-top:8px;display:flex;flex-direction:column;gap:5px}
.pill{display:flex;align-items:center;gap:5px;font-family:'Barlow Condensed','Barlow',sans-serif;font-weight:700;font-size:17px;border-radius:5px;padding:5px 6px;line-height:1.2}
.pill span{min-width:0;overflow-wrap:anywhere}
.workout-icon{width:18px;height:18px;flex:0 0 18px;display:block}
.event-label{background:var(--ink);color:#fff;border-left:3px solid var(--orange);font-family:'Barlow Condensed','Barlow',sans-serif;font-weight:700;font-size:17px;border-radius:5px;padding:5px 6px;line-height:1.2;overflow-wrap:anywhere}
.g3{display:inline-flex;align-items:center;background:var(--ink);color:#fff;font-family:'Barlow',sans-serif;font-size:13px;font-weight:700;letter-spacing:.3px;padding:3px 6px;border-radius:4px;line-height:1.1}
.note{font-size:15px;color:var(--muted);margin-top:7px;font-weight:500;line-height:1.25;overflow-wrap:anywhere}.note.flag{color:var(--accent);font-weight:600}
.strength{margin-top:20px;border:1px solid var(--line);border-radius:9px;padding:17px 18px;display:flex;align-items:flex-start;gap:22px;background:#F8F9FB}
.s-mid{flex:0 0 430px;min-width:0}.s-title{font-size:21px;font-weight:700;margin-bottom:12px;line-height:1.25}
.split{display:flex;border:1px solid var(--line);border-radius:7px;overflow:hidden;background:#fff}
.split>div{flex:1;padding:12px 6px;text-align:center;border-right:1px solid var(--line);min-width:0}.split>div:last-child{border-right:none}
.split .d{font-family:'Barlow Condensed','Barlow',sans-serif;font-weight:700;color:var(--accent);font-size:19px}
.split .b{font-size:16px;font-weight:600;color:var(--ink);line-height:1.3;margin-top:6px}
.s-list{flex:1;min-width:0}.s-list li{list-style:none;display:flex;gap:8px;align-items:flex-start;font-size:16px;font-weight:500;margin-bottom:7px;line-height:1.35}.s-list li:last-child{margin-bottom:0}
.chk{flex:0 0 18px;width:18px;height:18px;margin-top:2px}
.row3{display:grid;grid-template-columns:repeat({{ 1 + (1 if appearance.show_highlights else 0) + (1 if appearance.show_repeat_map else 0) }},minmax(0,1fr));gap:16px;margin-top:20px}
.panel{border:1px solid var(--line);border-radius:9px;background:#fff;overflow:hidden;min-width:0}
.panel .ph{display:flex;align-items:center;gap:8px;background:#F1F3F6;color:var(--ink);padding:11px 15px;font-size:20px;font-weight:700;line-height:1.2}
.panel .ph svg{width:21px;height:21px;flex:0 0 21px}.panel .pb{padding:15px}
.kd{display:flex;gap:10px;margin-bottom:13px;align-items:flex-start}.kd:last-child{margin-bottom:0}
.kd .ic{flex:0 0 23px;width:23px;height:23px;margin-top:1px}.kd .d{font-weight:700;font-size:17px;line-height:1.25}
.kd .t{font-size:16px;color:var(--muted);line-height:1.3;margin-top:3px;overflow-wrap:anywhere}
.hl{display:flex;gap:8px;font-size:16px;margin-bottom:10px;line-height:1.35;align-items:baseline}.hl:last-child{margin-bottom:0}
.dot{flex:0 0 10px;width:10px;height:10px;border-radius:50%;position:relative;top:1px}.hl b{font-weight:700}
.map{display:grid;grid-template-columns:1fr 1fr;gap:9px 16px}.map div{font-size:17px;font-weight:600;line-height:1.3}
.mapnote{margin-top:16px;color:var(--accent);font-weight:600;font-size:16px;line-height:1.35}
.empty{font-size:16px;color:var(--muted);line-height:1.4}
.bottom{margin-top:20px;border:1px solid var(--line);border-radius:9px;overflow:hidden}
.bottom .bh{background:#F1F3F6;color:var(--ink);padding:11px 15px;font-size:20px;font-weight:700;display:flex;align-items:center;gap:8px}.bottom .bh svg{width:21px;height:21px}
.bwrap{display:grid}.bcol{padding:15px;border-right:1px solid var(--line);min-width:0}.bcol:last-child{border-right:none}
.btype{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}.btype:last-child{margin-bottom:0}
.btype .pill{align-self:flex-start;font-size:16px}.btype p{font-size:15px;color:var(--muted);line-height:1.35}
.monthly-notes{display:grid;grid-template-columns:1fr 1fr;gap:14px 22px}
.bnote{display:flex;gap:10px;align-items:flex-start;min-width:0}.bnote svg{flex:0 0 22px;width:22px;height:22px;margin-top:1px}
.bnote p{font-size:16px;color:var(--muted);line-height:1.35;overflow-wrap:anywhere}.bnote p b{font-weight:700;color:var(--ink)}
.with-guide .monthly-notes{display:block}.with-guide .bnote{margin-bottom:13px}.with-guide .bnote:last-child{margin-bottom:0}
.credit{margin-top:15px;font-size:14px;color:var(--muted);font-weight:500;overflow-wrap:anywhere;line-height:1.35}
.poster-extra{margin-top:20px}.extra-copy{white-space:pre-wrap;overflow-wrap:anywhere;font-size:17px;line-height:1.4}
.poster-credits{margin-top:18px;padding-top:13px;border-top:1px solid var(--line);color:var(--muted);font-size:14px;line-height:1.5;overflow-wrap:anywhere}
.poster-credits h2{font-size:15px;color:var(--ink);margin-bottom:4px;font-weight:700}.credit-line{white-space:pre-wrap;min-height:1.5em}
.poster-credits a{color:var(--accent);text-decoration:underline;text-underline-offset:2px}
.density-compact .cal td{height:108px;padding:7px 7px 8px}.density-compact .dnum{font-size:26px}
.density-compact .pills{margin-top:6px;gap:4px}.density-compact .pill,.density-compact .event-label{font-size:16px;padding:4px 5px}
.density-compact .note{font-size:14px;margin-top:5px}.density-compact .strength,.density-compact .row3,.density-compact .bottom{margin-top:14px}
</style>
</head>
<body>
<div class="poster layout-{{ appearance.layout }} density-{{ appearance.density }}">
<div class="frame">
  <header>
    <div class="brandwrap">
      <h1><span class="otf">OTF</span> <span class="mo">{{ title_month }}</span></h1>
      <div class="sub">{{ subtitle }}</div>
      {% if theme %}<div class="theme">{{ theme|upper }}</div>{% endif %}
      {% if tagline %}<div class="tagline">{{ tagline|safe }}</div>{% endif %}
    </div>
  </header>
  {% if events %}
  <div class="ribbon event"><span class="tag">EVENT</span><span class="txt">{% for e in events %}{% if not loop.first %} &middot; {% endif %}{{ e.label }}{% endfor %}</span></div>
  {% endif %}
  {% if marked and appearance.show_marked_dates %}
  <div class="ribbon" data-section="marked-dates"><span class="tag">MARKED DATES</span><span class="txt">{% for md in marked %}{% if not loop.first %} &middot; {% endif %}{{ md.text }}{% endfor %}</span></div>
  {% endif %}
  <div class="cal">
    <table aria-label="{{ title_month }} workout schedule">
      <thead><tr>{% for d in ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'] %}<th scope="col">{{ d }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for week in weeks %}
        <tr>
        {% for cell in week %}
          {% if cell is none %}<td class="blank"></td>
          {% else %}
          <td{% if cell.weekend %} class="weekend"{% endif %}>
            <div class="dnum">{{ cell.day }}{% if cell.three_g %}<span class="g3">3G</span>{% endif %}</div>
            <div class="pills">
              {% for event in cell.events %}<div class="event-label">{{ event }}</div>{% endfor %}
              {% for p in cell.pills %}
              <div class="pill" style="background:{{ p.color }};color:{{ p.fg }}">{% if appearance.calendar_icons %}{{ icon(p.icon, cls="workout-icon") }}{% endif %}<span>{{ p.label }}</span></div>
              {% endfor %}
            </div>
            {% if cell.note %}<div class="note{% if cell.flag %} flag{% endif %}">{{ cell.note }}</div>{% endif %}
          </td>
          {% endif %}
        {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="strength">
    <div class="s-mid">
      <div class="s-title">Strength 50 / Tread 50 Weekly Pattern</div>
      <div class="split">
        {% for s in strength_split %}<div><div class="d">{{ s.days }}</div><div class="b">{{ s.focus }}</div></div>{% endfor %}
      </div>
    </div>
    <ul class="s-list">{% for n in notes %}<li>{{ icon(note_style.icon, cls="chk", color=note_style.color) }}<span>{{ n }}</span></li>{% endfor %}</ul>
  </div>
  <div class="row3">
    <div class="panel" data-section="key-dates">
      <div class="ph">{{ icon("calendar_month") }}Key Dates</div>
      <div class="pb">
        {% for k in key_dates %}<div class="kd">{{ icon(k.icon, cls="ic", color=k.color) }}<div><div class="d">{{ k.heading }}</div><div class="t">{{ k.detail }}</div></div></div>
        {% else %}<div class="empty">No benchmarks, signatures or specialties this month.</div>{% endfor %}
      </div>
    </div>
    {% if appearance.show_highlights %}
    <div class="panel" data-section="highlights">
      <div class="ph">{{ icon("equalizer") }}Template &amp; Equipment Highlights</div>
      <div class="pb">{% for h in highlights %}<div class="hl"><span class="dot" style="background:{{ h.color }}"></span><span><b style="color:{{ h.text_color }}">{{ h.label }}:</b> {{ h.value }}</span></div>{% endfor %}</div>
    </div>
    {% endif %}
    {% if appearance.show_repeat_map %}
    <div class="panel" data-section="repeat-map">
      <div class="ph">{{ icon("autorenew") }}Repeat Template Map</div>
      <div class="pb">
        {% if repeat_map %}<div class="map">{% for r in repeat_map %}<div>{{ r.day }} = {{ r.source }}</div>{% endfor %}</div>
        {% if non_repeat %}<div class="mapnote">{{ non_repeat|join(', ') }} {{ 'is' if non_repeat|length == 1 else 'are' }} not {{ 'a repeat' if non_repeat|length == 1 else 'repeats' }}</div>{% endif %}
        {% else %}<div class="empty">No repeated templates this month.</div>{% endif %}
      </div>
    </div>
    {% endif %}
  </div>
  <div class="bottom">
    <div class="bh">{{ icon("menu_book") }}{% if appearance.show_workout_guide %}Workout Types &amp; {% endif %}Monthly Notes</div>
    {% set legend_columns = (legend|batch([1, (legend|length / 3)|round(0,'ceil')|int]|max)|list) if appearance.show_workout_guide else [] %}
    <div class="bwrap{% if appearance.show_workout_guide %} with-guide{% endif %}" style="grid-template-columns:repeat({{ legend_columns|length + 1 }},1fr)">
      {% for col in legend_columns %}
      <div class="bcol" data-section="workout-guide">
        {% for t in col %}<div class="btype"><div class="pill" style="background:{{ t.color }};color:{{ t.fg }}">{% if appearance.calendar_icons %}{{ icon(t.icon, cls="workout-icon") }}{% endif %}<span>{{ t.label }}</span></div><p>{{ t.blurb }}</p></div>{% endfor %}
      </div>
      {% endfor %}
      <div class="bcol">
        <div class="monthly-notes">{% for f in footnotes %}<div class="bnote">{{ icon(f.icon, color=f.color) }}<p><b>{{ f.lead }}</b> {{ f.text }}</p></div>{% endfor %}</div>
      </div>
    </div>
  </div>
  {% if source_url %}<div class="credit">Schedule data from {{ source_url }}</div>{% endif %}
  {% if additional_info %}<section class="poster-extra panel"><div class="ph">Additional info</div><div class="pb extra-copy">{{ additional_info }}</div></section>{% endif %}
  {% if credit_lines %}
  <footer class="poster-credits">
    <h2>Credits &amp; team</h2>
    {% for line in credit_lines %}<div class="credit-line">{% for part in line %}{% if part.href %}<a href="{{ part.href }}" target="_blank" rel="noopener noreferrer">{{ part.text }}</a>{% else %}{{ part.text }}{% endif %}{% endfor %}</div>{% endfor %}
  </footer>
  {% endif %}
</div>
</div>
</body>
</html>
