{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import http.server,socketserver,os;port=int(os.environ['PORT']);os.chdir('site');socketserver.TCPServer.allow_reuse_address=True;httpd=socketserver.TCPServer(('',port),http.server.SimpleHTTPRequestHandler);print('Serving on port',port);httpd.serve_forever()"],
      "autoPort": true
    }
  ]
}
